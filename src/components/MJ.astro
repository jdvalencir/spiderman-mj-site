<svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg" class="hero-svg" role="img" aria-label="Original illustration of a red-haired character, MJ">
	<!-- Background glow -->
	<ellipse cx="150" cy="220" rx="140" ry="170" fill="#22c55e" opacity="0.12" />

	<!-- Body / top -->
	<path d="M105 210 Q150 190 195 210 L205 340 Q150 365 95 340 Z" fill="#16a34a" stroke="#1a1a1a" stroke-width="3" />

	<!-- Arms -->
	<path d="M105 215 Q75 235 68 275 Q66 288 78 290 Q90 292 95 275 Q102 245 118 225 Z" fill="#0f172a" stroke="#1a1a1a" stroke-width="3" />
	<path d="M195 215 Q225 235 232 275 Q234 288 222 290 Q210 292 205 275 Q198 245 182 225 Z" fill="#0f172a" stroke="#1a1a1a" stroke-width="3" />

	<!-- Neck -->
	<rect x="135" y="150" width="30" height="40" fill="#f4c2a1" />

	<!-- Head -->
	<circle cx="150" cy="115" r="52" fill="#f4c2a1" stroke="#1a1a1a" stroke-width="3" />

	<!-- Hair (back layer, behind head) -->
	<path d="M95 110 Q85 60 150 50 Q215 60 205 110 Q210 160 195 195 Q205 140 185 100 Q175 130 165 140 Q175 100 150 90 Q140 130 130 140 Q135 100 115 100 Q105 140 115 195 Q90 160 95 110 Z"
		fill="#e8590c" stroke="#1a1a1a" stroke-width="2.5" />

	<!-- Eyes -->
	<ellipse cx="130" cy="118" rx="7" ry="9" fill="#1a1a1a" />
	<ellipse cx="170" cy="118" rx="7" ry="9" fill="#1a1a1a" />

	<!-- Eyebrows -->
	<path d="M118 102 Q130 96 142 102" stroke="#8a3d00" stroke-width="3" fill="none" stroke-linecap="round" />
	<path d="M158 102 Q170 96 182 102" stroke="#8a3d00" stroke-width="3" fill="none" stroke-linecap="round" />

	<!-- Smile -->
	<path d="M128 145 Q150 162 172 145" stroke="#b3441c" stroke-width="4" fill="none" stroke-linecap="round" />

	<!-- Freckles -->
	<g fill="#c98a5e" opacity="0.6">
		<circle cx="118" cy="132" r="1.5" />
		<circle cx="124" cy="136" r="1.5" />
		<circle cx="176" cy="132" r="1.5" />
		<circle cx="182" cy="136" r="1.5" />
	</g>
</svg>

<style>
	.hero-svg {
		width: 100%;
		max-width: 320px;
		filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.4));
	}
</style>
